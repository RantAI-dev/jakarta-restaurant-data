# Salin ke .env lalu ganti nilainya. JANGAN commit .env.
S3_ACCESS_KEY=disparlake
S3_SECRET_KEY=disparlakesecret
META_PASSWORD=lakemeta
CH_PASSWORD=disparch
CATALOG_ENCRYPTION_KEY=ganti-kunci-ini-di-produksi

# Tenant default. Multi-tenant: satu bucket-prefix/namespace/database per tenant.
TENANT=dispar-dki
CH_APP_PASSWORD=disparapp

# ── Base lakehouse ops (backup / alert) ──
# Backup offsite (proteksi disk mati) — isi ke object storage lain:
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_BUCKET=lakehouse-backup
# Webhook alert kegagalan pipeline (Slack/Discord/generic):
ALERT_WEBHOOK_URL=
